{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr *)",
      "Bash(gh repo *)",
      "Read(./.env)",
      "Read(./**/.env)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(npm install -g *)",
      "Bash(brew install *)"
    ]
  }
}
